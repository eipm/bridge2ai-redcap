                }
            ]
        },
        {
            "id": "dsm_5_adult_social_phobia1",
            "form": "q_mood_dsm5_adult",
            "header": {
                "hash": "6781f48484",
                "translation": "DSM-5 Adult (Social Phobia)\n\nLas siguientes preguntas se refieren a pensamientos, sentimientos y comportamientos que pueda haber tenido acerca de situaciones sociales. Las situaciones sociales habituales incluyen: hablar en público, hablar en reuniones, asistir a eventos o fiestas sociales, presentarse a los demás, tener conversaciones, dar y recibir cumplidos, hacer peticiones a otros y comer y escribir en público.\n\nDurante los ÚLTIMOS 7 DÍAS, he..."
            },
            "enum": [
                {
                    "id": 0,
                    "hash": "80c3052d33",
                    "translation": "Nunca"
                },
                {
                    "id": 1,
                    "hash": "cd792a6c59",
                    "translation": "Ocasionalmente"
                },
                {
                    "id": 2,
                    "hash": "f0aadf25fb",
                    "translation": "la mitad del tiempo"
                },
                {
                    "id": 3,
                    "hash": "259eb1d4e0",
                    "translation": "La mayor parte del tiempo"
                },
                {
                    "id": 4,
                    "hash": "975588ef6d",
                    "translation": "Todo el tiempo"
                }
            ]
