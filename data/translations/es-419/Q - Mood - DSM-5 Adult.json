            "header": {
                "hash": "e0159f96d2",
                "translation": "Durante las últimas DOS (2) SEMANAS, ¿cuánto y que seguido le han molestado los siguientes problemas?\n\n0=Nada (Nunca), 1=Un Poco (menos de uno o dos días), 2=Levemente (Varios días), 3=Moderadamente (Más de la mitad de los días), 4=Severo (Todos los días)"
            },
            "enum": [
                {
                    "id": 0,
                    "hash": "531a625467",
                    "translation": "0=Nada (Nunca)"
                },
                {
                    "id": 1,
                    "hash": "ee545280f1",
                    "translation": "1=Un Poco (menos de uno o dos días)"
                },
                {
                    "id": 2,
                    "hash": "5602d047d6",
                    "translation": "2=Levemente (Varios días)"
                },
                {
                    "id": 3,
